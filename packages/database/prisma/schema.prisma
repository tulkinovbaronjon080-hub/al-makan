// Al-Makan — Phase 0 schema scope.
// Only tenancy/identity + location primitives ship now. Orders, catalog,
// inventory movements, production, POS, finance, etc. are added module by
// module starting Phase 1+ (see /packages/database/README.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy / Identity ----------

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  // Per-business order numbering — assigned via an atomic increment inside
  // OrdersService, never computed with max()+1 (race-prone under concurrency).
  nextOrderNumber Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members   BusinessMember[]
  roles     Role[]
  locations Location[]
  customers Customer[]
  orders    Order[]
  brands    Brand[]
  series    ProfileSeries[]
  profiles  Profile[]
  glasses   Glass[]
  colors    Color[]
  accessories Accessory[]

  @@map("businesses")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        BusinessMember[]
  refreshTokens      RefreshToken[]
  orderStatusChanges OrderStatusHistory[]

  @@map("users")
}

// Refresh tokens are stored server-side (hashed) so logout / revocation is
// real, not just "client forgets the JWT". Rotated on every use.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum BusinessMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

// Join table: a user can belong to multiple businesses, each membership
// carrying its own role. v1 UI only ever surfaces one "active business" at
// a time, but the schema supports more without a later migration.
model BusinessMember {
  id         String                @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  status     BusinessMemberStatus  @default(ACTIVE)
  joinedAt   DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// Seeded system roles (OWNER, ADMIN, MANAGER, SALES, MEASUREMENT,
// PRODUCTION, WAREHOUSE, STORE_CASHIER, INSTALLER) have businessId = null
// and isSystem = true. A business can later define custom roles scoped to
// itself (businessId set, isSystem = false).
model Role {
  id         String   @id @default(cuid())
  businessId String?
  name       String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  business    Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     BusinessMember[]

  @@unique([businessId, name])
  @@map("roles")
}

// Granular permission keys, e.g. "inventory.view", "orders.create".
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- Locations (inventory foundation) ----------

enum LocationType {
  WAREHOUSE
  STORE
  SHOWROOM
  FACTORY
  OTHER
}

model Location {
  id         String       @id @default(cuid())
  businessId String
  name       String
  type       LocationType
  address    String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("locations")
}

// ---------- Product catalog ----------
// Pricing/spec reference data the Phase 4 configurator and Phase 5
// calculation engine will read from — never hard-coded (brief §13/§14).
// Fully business-scoped (no system-seeded defaults — every manufacturer
// sources different brands/prices) and soft-disabled, never hard-deleted,
// once orders can reference a specific profile/glass/etc.

model Brand {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  series   ProfileSeries[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

model ProfileSeries {
  id         String   @id @default(cuid())
  businessId String
  brandId    String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profiles Profile[]

  @@unique([brandId, name])
  @@index([businessId])
  @@map("profile_series")
}

model Profile {
  id            String   @id @default(cuid())
  businessId    String
  seriesId      String
  name          String // e.g. "Frame", "Sash", "Mullion"
  pricePerMeter Int // whole UZS per meter
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  series     ProfileSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([seriesId, name])
  @@index([businessId])
  @@map("profiles")
}

model Glass {
  id         String   @id @default(cuid())
  businessId String
  name       String // e.g. "4mm tempered"
  pricePerM2 Int // whole UZS per m²
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("glasses")
}

model Color {
  id                String   @id @default(cuid())
  businessId        String
  name              String // e.g. "White", "Wood-effect walnut"
  surchargePerMeter Int      @default(0) // whole UZS added per meter of profile
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("colors")
}

model Accessory {
  id         String   @id @default(cuid())
  businessId String
  name       String // e.g. "Handle - white"
  price      Int // whole UZS per piece
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
  @@map("accessories")
}

// ---------- Customers / Orders ----------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  fullName   String
  phone      String
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("customers")
}

enum OrderStatus {
  NEW
  MEASUREMENT
  CALCULATED
  CONFIRMED
  PRODUCTION
  READY
  INSTALLATION
  COMPLETED
  CANCELLED
}

// Header-only this phase — no products/pricing until the catalog (Phase 3),
// configurator (Phase 4), and calculation engine (Phase 5) exist to attach
// OrderItems. See the Phase 2 plan for why a state machine isn't enforced yet.
model Order {
  id          String      @id @default(cuid())
  businessId  String
  orderNumber Int
  customerId  String
  status      OrderStatus @default(NEW)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  statusHistory OrderStatusHistory[]
  items         OrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([customerId])
  @@map("orders")
}

enum OpeningDirection {
  FIXED
  LEFT_HINGED
  RIGHT_HINGED
  TILT_TURN
}

// Phase 4 (configurator UI) ships this so the configurator has somewhere
// real to save its output. The cost/BOM fields are a SNAPSHOT of whatever
// @al-makan/calculation-engine returned at save time — Phase 5 replacing
// the formula internals must never silently reprice existing items (same
// principle as Phase 1's token snapshots). No businessId of its own —
// tenant-scoped implicitly through its parent Order, same as
// OrderStatusHistory above.
model OrderItem {
  id               String           @id @default(cuid())
  orderId          String
  productType      String // matches calculation-engine's ProductType union
  widthMm          Int
  heightMm         Int
  sections         Int
  openingDirection OpeningDirection
  profileId        String
  glassId          String
  colorId          String
  accessoryIds     Json // string[] of Accessory ids — no join table needed yet
  quantity         Int              @default(1)

  // Snapshotted calculateProductConfiguration() output:
  materialCost   Int
  laborCost      Int
  additionalCost Int
  totalCost      Int
  margin         Int
  sellingPrice   Int
  bom            Json // BomLine[] snapshot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // No onDelete override — Postgres' default blocks deleting a catalog row
  // that's in use, reinforcing Phase 3's soft-disable-only policy.
  profile Profile @relation(fields: [profileId], references: [id])
  glass   Glass   @relation(fields: [glassId], references: [id])
  color   Color   @relation(fields: [colorId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// User-facing status timeline for the Order Detail screen — distinct from
// AuditLog, which stays reserved for the identity/security events Phase 1
// established. Every status change (including the initial NEW) appends a row.
model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime    @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------- Audit ----------

// Written (not yet browsable — that's Phase 11/Reports) on sensitive
// operations: login, register, role/status changes. businessId/actorUserId
// are nullable because a failed login before a business is resolved (or a
// register attempt) still needs to be logged.
model AuditLog {
  id           String   @id @default(cuid())
  businessId   String?
  actorUserId  String?
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([actorUserId])
  @@map("audit_logs")
}
