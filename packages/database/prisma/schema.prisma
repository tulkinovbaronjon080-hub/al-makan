// Al-Makan — Phase 0 schema scope.
// Only tenancy/identity + location primitives ship now. Orders, catalog,
// inventory movements, production, POS, finance, etc. are added module by
// module starting Phase 1+ (see /packages/database/README.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy / Identity ----------

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  // Per-business order numbering — assigned via an atomic increment inside
  // OrdersService, never computed with max()+1 (race-prone under concurrency).
  nextOrderNumber Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members   BusinessMember[]
  roles     Role[]
  locations Location[]
  customers Customer[]
  orders    Order[]

  @@map("businesses")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        BusinessMember[]
  refreshTokens      RefreshToken[]
  orderStatusChanges OrderStatusHistory[]

  @@map("users")
}

// Refresh tokens are stored server-side (hashed) so logout / revocation is
// real, not just "client forgets the JWT". Rotated on every use.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum BusinessMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

// Join table: a user can belong to multiple businesses, each membership
// carrying its own role. v1 UI only ever surfaces one "active business" at
// a time, but the schema supports more without a later migration.
model BusinessMember {
  id         String                @id @default(cuid())
  businessId String
  userId     String
  roleId     String
  status     BusinessMemberStatus  @default(ACTIVE)
  joinedAt   DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// Seeded system roles (OWNER, ADMIN, MANAGER, SALES, MEASUREMENT,
// PRODUCTION, WAREHOUSE, STORE_CASHIER, INSTALLER) have businessId = null
// and isSystem = true. A business can later define custom roles scoped to
// itself (businessId set, isSystem = false).
model Role {
  id         String   @id @default(cuid())
  businessId String?
  name       String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  business    Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     BusinessMember[]

  @@unique([businessId, name])
  @@map("roles")
}

// Granular permission keys, e.g. "inventory.view", "orders.create".
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- Locations (inventory foundation) ----------

enum LocationType {
  WAREHOUSE
  STORE
  SHOWROOM
  FACTORY
  OTHER
}

model Location {
  id         String       @id @default(cuid())
  businessId String
  name       String
  type       LocationType
  address    String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("locations")
}

// ---------- Customers / Orders ----------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  fullName   String
  phone      String
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("customers")
}

enum OrderStatus {
  NEW
  MEASUREMENT
  CALCULATED
  CONFIRMED
  PRODUCTION
  READY
  INSTALLATION
  COMPLETED
  CANCELLED
}

// Header-only this phase — no products/pricing until the catalog (Phase 3),
// configurator (Phase 4), and calculation engine (Phase 5) exist to attach
// OrderItems. See the Phase 2 plan for why a state machine isn't enforced yet.
model Order {
  id          String      @id @default(cuid())
  businessId  String
  orderNumber Int
  customerId  String
  status      OrderStatus @default(NEW)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  statusHistory OrderStatusHistory[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([customerId])
  @@map("orders")
}

// User-facing status timeline for the Order Detail screen — distinct from
// AuditLog, which stays reserved for the identity/security events Phase 1
// established. Every status change (including the initial NEW) appends a row.
model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime    @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------- Audit ----------

// Written (not yet browsable — that's Phase 11/Reports) on sensitive
// operations: login, register, role/status changes. businessId/actorUserId
// are nullable because a failed login before a business is resolved (or a
// register attempt) still needs to be logged.
model AuditLog {
  id           String   @id @default(cuid())
  businessId   String?
  actorUserId  String?
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([actorUserId])
  @@map("audit_logs")
}
